# Copiar para .env e preencher (o .env nunca deve ir para o Git)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/gestao_alunos?retryWrites=true&w=majority
PORT=3001
# Origens permitidas pelo CORS, separadas por vírgula. * = todas
CORS_ORIGIN=*
# Só se der "querySrv ECONNREFUSED" (o DNS da rede recusa consultas SRV). Não é preciso no Render.
# DNS_SERVERS=8.8.8.8,1.1.1.1
